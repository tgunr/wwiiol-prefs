<?xml version='1.0'?>
<!DOCTYPE controlset SYSTEM "cfml.dtd">
<controlset version="1.1.0" language="english" keyboard="us">
	<control function="Toggle internal/external views">
		<combo>
			<key>left control</key>
			<key>v</key>
		</combo>
	</control>
	<control function="External locked">
		<combo>
			<key>left control</key>
			<key>f9</key>
		</combo>
	</control>
	<control function="External rubberband">
		<combo>
			<key>left control</key>
			<key>f10</key>
		</combo>
	</control>
	<control function="External fixed">
		<combo>
			<key>left control</key>
			<key>f11</key>
		</combo>
	</control>
	<control function="Slew view left">
		<key>delete</key>
	</control>
	<control function="Slew view right">
		<key>page down</key>
	</control>
	<control function="Slew view up">
		<key>home</key>
	</control>
	<control function="Slew view down">
		<key>end</key>
	</control>
	<control function="Set fixed camera">
		<combo>
			<key>left control</key>
			<key>f12</key>
		</combo>
	</control>
	<control function="Change field of view">
		<key>f10</key>
	</control>
	<control function="Display GUI">
		<combo>
			<key>left control</key>
			<key>left shift</key>
		</combo>
	</control>
	<control function="Show Cursor">
		<key>left alt</key>
	</control>
	<control function="Map Zoom In">
		<key>numpad +</key>
	</control>
	<control function="Map Zoom Out">
		<key>numpad -</key>
	</control>
	<control function="Continue Tutorial">
		<key>space</key>
	</control>
	<control function="Toggle chat window on/off">
		<key>enter</key>
	</control>	
	<control function="Toggle radio buffer on/off">
		<combo>
			<key>left alt</key>
			<key>t</key>
		</combo>
	</control>	
	<control function="Show in game map">
		<key>m</key>
	</control>
	<control function="Screen shot">
		<key>f9</key>
	</control>
	<control function="Exit game world">
		<key>escape</key>
	</control>
	<control function="Roll view left">
		<key>insert</key>
	</control>	
	<control function="Roll view right">
		<key>page up</key>
	</control>
        <control function="Change HUD detail">
		<key>y</key>
	</control>
	<control function="Reset HUD">
		<combo>
			<key>left control</key>
			<key>y</key>
		</combo>
	</control>
	<control function="Show Game Info">
		<key>num lock</key>
	</control>
	<control function="Show Vehicle Status">
		<key>`</key>
	</control>
	<control function="Cycle Icon Mode">
		<combo>
			<key>left control</key>
			<key>i</key>
		</combo>
	</control>
	<control function="Change Chat height">
		<key>tab</key>
	</control>
</controlset>
